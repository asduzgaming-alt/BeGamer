---
import BaseLayout from '../layouts/BaseLayout.astro';import Home from '../sections/Home.astro';import ServiceDetail from '../sections/ServiceDetail.astro';import ProjectDetail from '../sections/ProjectDetail.astro';import ContactSection from '../sections/ContactSection.astro';import SectionHeading from '../components/SectionHeading.astro';import ServiceCard from '../components/ServiceCard.astro';import ProjectsGallery from '../components/ProjectsGallery.astro';import ResponsiveImage from '../components/ResponsiveImage.astro';import Button from '../components/Button.astro';import Icon from '../components/Icon.astro';
import {text,type Locale} from '../i18n';import {services} from '../content/services';import {projects} from '../content/projects';import {route,paths,serviceRoute,projectRoute,review,type RouteId} from '../lib/routes';
export function getStaticPaths(){
 const result=[];for(const locale of ['es','en'] as const){const other=locale==='es'?'en':'es';for(const id of Object.keys(paths) as RouteId[]){result.push({params:{path:route(locale,id).slice(1,-1)},props:{locale,id,path:route(locale,id),alternate:route(other,id)}})}for(const service of services){result.push({params:{path:serviceRoute(locale,service.id).slice(1,-1)},props:{locale,id:'service',serviceId:service.id,path:serviceRoute(locale,service.id),alternate:serviceRoute(other,service.id)}})}for(const project of projects.filter(p=>review||p.status==='published')){result.push({params:{path:projectRoute(locale,project.id).slice(1,-1)},props:{locale,id:'project',projectId:project.id,path:projectRoute(locale,project.id),alternate:projectRoute(other,project.id)}})}}return result;
}
const {locale,id,path,alternate,serviceId,projectId}=Astro.props;const t=text[locale as Locale];const service=services.find(s=>s.id===serviceId);const project=projects.find(p=>p.id===projectId);
const titles:Record<string,string>={home:locale==='es'?'Gaming marketing y esports':'Gaming marketing and esports',services:t.nav[1],projects:t.nav[2],about:t.nav[3],contact:t.nav[4],privacy:locale==='es'?'Privacidad':'Privacy'};
const title=`${service?service[locale as Locale].name:project?project.title:titles[id]} | BeGamer Agency`;
const descriptions:Record<string,string>={home:t.heroDescription,services:t.servicesDescription,projects:t.projectsDescription,about:t.aboutDescription,contact:t.contactDescription,privacy:t.privacyIntro};const description=service?service[locale as Locale].description:project?project.alt[locale as Locale]:descriptions[id];
---
<BaseLayout locale={locale as Locale} title={title} description={description} path={path} alternate={alternate} home={id==='home'} active={(id==='service'?'services':id==='project'?'projects':id) as RouteId} noindex={id==='privacy'||id==='project'}>
 {id==='home'&&<Home locale={locale as Locale}/>}
 {id==='service'&&service&&<ServiceDetail locale={locale as Locale} service={service}/>}
 {id==='project'&&projectId&&<ProjectDetail locale={locale as Locale} id={projectId}/>}
 {id==='contact'&&<ContactSection locale={locale as Locale} standalone/>}
 {id==='services'&&<><section class="internal-hero"><div class="container"><p class="eyebrow">{t.nav[1]}</p><h1 class="internal-title">{t.servicesTitle}</h1><p class="internal-description">{t.servicesDescription}</p></div></section><div class="container services-grid">{services.map(s=><ServiceCard service={s} locale={locale as Locale}/>)}</div><section class="detail-cta"><h2>{t.contactTitle}</h2><Button href={route(locale as Locale,'contact')}>{t.talk}</Button></section></>}
 {id==='projects'&&<><section class="internal-hero"><div class="container"><p class="eyebrow">{t.nav[2]}</p><h1 class="internal-title">{t.projectsTitle}</h1><p class="internal-description">{t.projectsDescription}</p></div></section><section class="container"><ProjectsGallery locale={locale as Locale}/></section><section class="detail-cta"><h2>{t.related}</h2><Button href={route(locale as Locale,'contact')}>{t.talk}</Button></section></>}
 {id==='about'&&<><section class="internal-hero"><div class="container"><p class="eyebrow">{t.nav[3]}</p><h1 class="internal-title">{t.aboutTitle}</h1><p class="internal-description">{t.aboutDescription}</p></div></section><div class="container internal-media"><ResponsiveImage id="about" alt={t.aboutDescription} eager sizes="100vw"/></div><section class="section"><div class="container detail-layout"><div><p class="eyebrow">BeGamer Agency</p><h2>{t.philosophy}</h2></div><div><p class="lead">{t.aboutBody}</p><p class="detail-note">{t.philosophyBody}</p></div></div></section><div class="container"><div class="pillars">{t.pillars.map((p,i)=><div><Icon name={['game','chart','cube'][i]}/><h3>{p}</h3><p>{t.pillarDescriptions[i]}</p></div>)}</div></div><section class="detail-cta"><h2>{t.contactTitle}</h2><Button href={route(locale as Locale,'contact')}>{t.talk}</Button></section></>}
 {id==='privacy'&&<section class="section standalone"><div class="container legal"><p class="eyebrow">BeGamer Agency</p><h1>{t.privacyTitle}</h1><p>{t.privacyIntro}</p><p>{t.privacyBody}</p><p class="detail-note">{t.privacyStatus}</p><Button href={route(locale as Locale,'home')}>{t.home}</Button></div></section>}
</BaseLayout>
