---
import {text,type Locale} from '../i18n'; import ContactForm from '../components/ContactForm.astro'; import Icon from '../components/Icon.astro'; import SocialIcon from '../components/SocialIcon.astro'; import {whatsapp,socials,whatsappUrl} from '../content/social';
const {locale,standalone=false}=Astro.props as {locale:Locale;standalone?:boolean}; const t=text[locale]; const Tag=standalone?'h1':'h2';
---
<section id="contact" class:list={['section','contact-section',standalone&&'standalone']} data-section><div class="container contact-grid"><div class="contact-copy"><p class="eyebrow">{t.nav[4]}</p><Tag>{t.contactTitle}</Tag><p class="lead">{t.contactDescription}</p><div class="contact-location"><span class="icon-box"><Icon name="pin"/></span><div><strong>{t.location}</strong><p>{t.locationDescription}</p></div></div><a class="contact-whatsapp" href={whatsappUrl(t.whatsappMessage)} target="_blank" rel="noopener"><span class="icon-box"><SocialIcon name="whatsapp" size={22}/></span><div><strong>WhatsApp</strong><p>{whatsapp.display}</p></div></a><div class="social-links" aria-label={t.follow}>{socials.map(s=><a href={s.url} target="_blank" rel="noopener" aria-label={s.name}><SocialIcon name={s.id}/></a>)}</div><span class="contact-line" aria-hidden="true"></span></div><ContactForm locale={locale}/></div></section>
