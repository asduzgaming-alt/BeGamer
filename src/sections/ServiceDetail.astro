---
import type {Locale} from '../i18n';import {text} from '../i18n';import type {Service} from '../content/services';import {route} from '../lib/routes';
import ResponsiveImage from '../components/ResponsiveImage.astro';import Button from '../components/Button.astro';import Icon from '../components/Icon.astro';import SchoolArt from '../components/SchoolArt.astro';
const {locale,service}=Astro.props as {locale:Locale;service:Service};const t=text[locale],s=service[locale];
const images=service.id==='game-building'?['roblox-main','roblox-sub1','roblox-sub2','minecraft-main','minecraft-sub1','minecraft-sub2']:service.id==='live-esports'?['event-ascension','event-ignite','event-mobilemasters']:[];
---
<section class="internal-hero"><div class="container"><nav class="breadcrumbs" aria-label={locale==='es'?'Ruta de navegación':'Breadcrumb'}><a href={route(locale,'home')}>{t.nav[0]}</a><span>/</span><a href={route(locale,'services')}>{t.nav[1]}</a><span>/</span><span>{s.name}</span></nav><p class="eyebrow">{s.name}</p><h1 class="internal-title">{s.title}</h1><p class="internal-description">{s.description}</p><Button href={`${route(locale,'contact')}?service=${service.id}`}>{t.proposal}</Button></div></section>
<div class="container internal-media">{service.image?<ResponsiveImage id={service.image} alt={s.title} eager sizes="100vw"/>:<SchoolArt locale={locale}/>}</div>
<section class="section"><div class="container detail-layout"><div><p class="eyebrow">{s.name}</p><h2>{t.formats}</h2><p class="lead">{s.audience}</p><p class="detail-note">{s.note}</p></div><ul class="format-list">{s.capabilities.map(item=><li><Icon name="plus"/>{item}</li>)}</ul></div></section>
<section class="section process-section"><div class="container"><p class="eyebrow">{t.processLabel}</p><h2>{t.process}</h2><div class="process-grid">{t.processSteps.map((step,i)=><div><h3>{step}</h3><p>{t.processDescriptions[i]}</p></div>)}</div></div></section>
{images.length>0&&<section class="section"><div class="container"><p class="eyebrow">{t.visualArchive}</p><h2>{t.gallery}</h2><div class="media-gallery">{images.map((id,i)=><button type="button" class:list={[id.startsWith('event')&&'poster']} data-lightbox={`/assets/images/${id}-${id==='minecraft-sub1'?607:id==='minecraft-sub2'?1280:id==='event-ascension'||id==='event-mobilemasters'?1080: id==='minecraft-main'?1536:1600}.webp`} aria-label={`${locale==='es'?'Ampliar imagen':'Enlarge image'} ${i+1}`}><ResponsiveImage id={id} alt={id.startsWith('event')?(locale==='es'?'Pieza gráfica de un torneo de esports.':'An esports tournament poster.'):(locale==='es'?'Captura de un entorno de juego del portafolio.':'Screenshot of a game environment from the portfolio.')}/></button>)}</div></div></section>}
{images.length>0&&<dialog class="lightbox"><button aria-label={t.close}><Icon name="close"/></button><img src="/assets/logo.png" alt=""/></dialog>}
<section class="detail-cta"><h2>{t.contactTitle}</h2><Button href={`${route(locale,'contact')}?service=${service.id}`}>{t.proposal}</Button></section>
