---
import {text,type Locale} from '../i18n'; import {services} from '../content/services'; import {brands} from '../content/brands'; import {route,review} from '../lib/routes';
import ResponsiveImage from '../components/ResponsiveImage.astro'; import SectionHeading from '../components/SectionHeading.astro'; import ServiceCard from '../components/ServiceCard.astro'; import ProjectsGallery from '../components/ProjectsGallery.astro'; import Button from '../components/Button.astro'; import Icon from '../components/Icon.astro'; import ContactSection from './ContactSection.astro'; import FaqSection from './FaqSection.astro'; import InteractiveBGLogo from '../three/InteractiveBGLogo';
const {locale}=Astro.props as {locale:Locale}; const t=text[locale]; const model=import.meta.env.PUBLIC_BG_MODEL;
---
<section id="home" class="hero" data-section>
 <div class="hero-photo"><ResponsiveImage id="site/hero-bg" alt={locale==='es'?'Casters con auriculares narrando en vivo un torneo de ECUP Gaming.':'Casters with headsets commentating live at an ECUP Gaming tournament.'} eager sizes="(max-width: 767px) 100vw, 70vw"/></div>
 <div class="hero-shade"></div><div class="hero-diagonals" aria-hidden="true"></div>
 <div class="hero-emblem" aria-hidden="true">{model?<InteractiveBGLogo client:idle modelUrl={model}/>:<div class="bg-fallback"><img src="/assets/logo.png" alt="" width="150" height="150"/><span></span></div>}</div>
 <div class="container hero-content"><h1>{t.hero.map((line,i)=>line&&<span class:list={[i>1&&'gradient-text']}>{line}</span>)}</h1><p class="hero-description">{t.heroDescription}</p><Button href="#services">{t.explore}</Button><a href="#services" class="scroll-cue"><span class="mouse-icon"></span>{t.scroll}<span>↓</span></a></div>
</section>
<div class="mega-marquee" aria-hidden="true">
 <div class="marquee-row" data-marquee="1"><div class="marquee-track">{[0,1,2].map(()=>t.marquee.map(w=><span>{w}<i></i></span>))}</div></div>
 <div class="marquee-row marquee-row--outline" data-marquee="-1"><div class="marquee-track">{[0,1,2].map(()=>[...t.marquee].reverse().map(w=><span>{w}<i></i></span>))}</div></div>
</div>
<section id="services" class="section services-section" data-section><div class="container"><SectionHeading label={t.nav[1]} title={t.servicesTitle} description={t.servicesDescription}><Button href={route(locale,'services')} variant="text">{t.allServices}</Button></SectionHeading><div class="services-grid">{services.map(service=><ServiceCard service={service} locale={locale}/>)}</div></div></section>
<section id="trusted" class="section trusted-section" data-section><div class="container"><SectionHeading label={t.trusted} title={t.trustedTitle} description={t.trustedDescription}/><div class="brand-carousel"><button type="button" class="carousel-control prev" data-brand-prev aria-label={t.previous}><Icon name="arrow"/></button><div class="brand-track" tabindex="0" aria-label={t.trusted}>{brands.filter(b=>review||b.approved).map(b=><div class="brand-item"><img src={`/assets/brands/${b.source.replace(/\.(png|jpg)$/,'.webp')}`} alt={b.name} width="160" height="60" loading="lazy"/></div>)}</div><button type="button" class="carousel-control" data-brand-next aria-label={t.next}><Icon name="arrow"/></button></div></div></section>
<section id="projects" class="section projects-section" data-section><div class="container"><SectionHeading label={t.nav[2]} title={t.projectsTitle} description={t.projectsDescription}><Button href={route(locale,'projects')} variant="text">{t.allProjects}</Button></SectionHeading><ProjectsGallery locale={locale} featured/></div></section>
<section id="about" class="section about-section" data-section><div class="container"><SectionHeading label={t.nav[3]} title={t.aboutTitle} description={t.aboutDescription}><Button href={route(locale,'about')} variant="text">{t.aboutCta}</Button></SectionHeading><div class="about-photo"><ResponsiveImage id="projects/ascension-league/second-season-2" alt={locale==='es'?'Comunidad de jugadores reunida en el escenario de Ascension League.':'A community of players together on the Ascension League stage.'}/></div></div></section>
<FaqSection locale={locale}/>
<ContactSection locale={locale}/>
