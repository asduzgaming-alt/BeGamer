---
import {text,type Locale} from '../i18n'; import SectionHeading from '../components/SectionHeading.astro'; import Button from '../components/Button.astro';
const {locale}=Astro.props as {locale:Locale}; const t=text[locale];
const schema={'@context':'https://schema.org','@type':'FAQPage',inLanguage:locale,mainEntity:t.faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<section id="faq" class="section faq-section" data-section>
 <div class="container faq-layout">
  <div class="faq-aside" data-reveal>
   <SectionHeading label={t.faqLabel} title={t.faqTitle}/>
   <p class="faq-description">{t.faqDescription}</p>
   <Button href="#contact">{t.talk}</Button>
   <span class="faq-count" aria-hidden="true">{String(t.faqs.length).padStart(2,'0')}</span>
  </div>
  <div class="faq-list">
   {t.faqs.map((f,i)=><details class="faq-item" data-faq open={i===0}>
    <summary><span class="faq-index" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><span class="faq-question">{f.q}</span><span class="faq-toggle" aria-hidden="true"></span></summary>
    <div class="faq-answer"><p>{f.a}</p></div>
   </details>)}
  </div>
 </div>
 <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
</section>
