---
import {text,type Locale} from '../i18n';import {projects} from '../content/projects';import {projectRoute,route,review} from '../lib/routes';import ResponsiveImage from '../components/ResponsiveImage.astro';import MediaGallery from '../components/MediaGallery.astro';import Button from '../components/Button.astro';import Icon from '../components/Icon.astro';
const {locale,id}=Astro.props as {locale:Locale;id:string};const t=text[locale];const p=projects.find(p=>p.id===id)!;const visible=projects.filter(p=>review||p.status==='published');const next=visible[(visible.indexOf(p)+1)%visible.length];
const [cover,...rest]=p.images;const photo=locale==='es'?'Foto':'Photo';
---
<div class="project-detail"><section class="internal-hero"><div class="container"><nav class="breadcrumbs" aria-label={locale==='es'?'Ruta de navegación':'Breadcrumb'}><a href={route(locale,'home')}>{t.nav[0]}</a><span>/</span><a href={route(locale,'projects')}>{t.nav[2]}</a><span>/</span><span>{p.title}</span></nav><p class="eyebrow">{p.kicker[locale]}</p><h1 class="internal-title">{p.title}</h1><p class="internal-description">{p.summary[locale]}</p>{p.status!=='published'&&<p class="editorial-note">{t.draft}</p>}</div></section><div class="container internal-media"><ResponsiveImage id={cover} alt={p.alt[locale]} eager sizes="90vw"/></div>
{rest.length>0&&<section class="section"><div class="container"><p class="eyebrow">{t.visualArchive}</p><h2>{t.gallery}</h2><MediaGallery ids={rest} alt={(_,i)=>`${p.title}: ${photo.toLowerCase()} ${i+2}`} enlarge={locale==='es'?'Ampliar imagen':'Enlarge image'}/></div></section><dialog class="lightbox"><button aria-label={t.close}><Icon name="close"/></button><img src="/assets/logo.png" alt=""/></dialog>}
<div class="container"><div class="project-next"><a href={route(locale,'projects')}>{t.backProjects}</a>{next&&next.id!==id&&<a href={projectRoute(locale,next.id)}><span>{t.nextProject}</span><strong>{next.title} ↗</strong></a>}</div></div><section class="detail-cta"><h2>{t.related}</h2><Button href={route(locale,'contact')}>{t.similar}</Button></section></div>
